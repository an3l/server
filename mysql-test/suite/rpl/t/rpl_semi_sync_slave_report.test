# The test verifies that replicas report their replication information to the master

--source include/master-slave.inc
--source include/have_binlog_format_mixed.inc

--echo #
--echo # MDEV-21322: report slave progress to the master
--echo #

--echo # ***** TEST A: repl_semisync_wait_point is default (AFTER_COMMIT) and check what happens *****
SET @start_global_value = @@global.rpl_semi_sync_master_wait_point;
let $my_wait_point= "AFTER_COMMIT";

--source include/rpl_semi_sync_report.inc

--echo # ***** TEST B: repl_semisync_wait_point = None and check what happens *****
let $my_wait_point= "AFTER_SYNC";
--source include/rpl_semi_sync_report.inc

--echo # ***** TEST C: repl_semisync_wait_point = None and check what happens *****
# This is the only valid test case where things should happen!
let $my_wait_point= None;
--source include/rpl_semi_sync_report.inc

#
# Cleanup
#
SET @@global.rpl_semi_sync_master_wait_point = @start_global_value;
--source include/rpl_end.inc
