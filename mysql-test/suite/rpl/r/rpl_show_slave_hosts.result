include/master-slave.inc
[connection master]
connect  slave2,127.0.0.1,root,,test,$SLAVE_MYPORT2,;
connection slave2;
RESET SLAVE;
CHANGE MASTER TO master_host='127.0.0.1',master_port=MASTER_PORT,master_user='root';
START SLAVE IO_THREAD;
include/wait_for_slave_io_to_start.inc
connection master;
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id	Gtid_State_Sent	Gtid_State_Ack
3	slave2	SLAVE_PORT	1		
2	localhost	SLAVE_PORT	1		
connection slave2;
include/stop_slave_io.inc
connection master;
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id	Gtid_State_Sent	Gtid_State_Ack
2	localhost	SLAVE_PORT	1		
#
# MDEV-21322: report slave progress to the master
#
select @@global.rpl_semi_sync_master_wait_point;
@@global.rpl_semi_sync_master_wait_point
AFTER_COMMIT
reset master;
# Test 1: Master has not enabled semisync
# Note:   even if not enabled semisync 2 new columns should be visible
#         that means, command should return 6 columns,
#         with already connected replica server_id=2
# -------------------------------------------
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id	Gtid_State_Sent	Gtid_State_Ack
2	localhost	SLAVE_PORT	1		
# Test 2: Master enabled semisync
# Note:   it should be the same as test 1
# -------------------------------------------
set global rpl_semi_sync_master_enabled = 1;
show variables like 'rpl_semi_sync_master_enabled';
Variable_name	Value
rpl_semi_sync_master_enabled	ON
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id	Gtid_State_Sent	Gtid_State_Ack
2	localhost	SLAVE_PORT	1		
# Test 3: Replica enabled semisync
# Note:   No new GTIDs expected empty result
# -------------------------------------------
connection slave;
stop slave;
reset slave;
set global rpl_semi_sync_slave_enabled = 1;
start slave;
show variables like 'rpl_semi_sync_slave_enabled';
Variable_name	Value
rpl_semi_sync_slave_enabled	ON
include/wait_for_slave_io_to_start.inc
connection master;
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Gtid_State_Sent	Gtid_State_Ack
2	localhost	SLAVE_PORT	1		
show variables like 'rpl_semi_sync_master_enabled';
Variable_name	Value
rpl_semi_sync_master_enabled	ON
# Test 4: Make new events - generate new GTID
# Note:   -
# -------------------------------------------
create table t(t int);
insert into t values (1);
show status like 'Rpl_semi_sync_master_status';
Variable_name	Value
Rpl_semi_sync_master_status	ON
show status like 'Rpl_semi_sync_master_no_tx';
Variable_name	Value
Rpl_semi_sync_master_no_tx	0
show status like 'Rpl_semi_sync_master_yes_tx';
Variable_name	Value
Rpl_semi_sync_master_yes_tx	2
show status like 'Rpl_semi_sync_master_clients';
Variable_name	Value
Rpl_semi_sync_master_clients	1
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Gtid_State_Sent	Gtid_State_Ack
2	localhost	SLAVE_PORT	1	0-1-2	
# cleanup
# -------------------------------------------
connection master;
drop table t;
connection slave;
stop slave;
reset slave;
set global rpl_semi_sync_slave_enabled = 0;
start slave;
show variables like 'rpl_semi_sync_slave_enabled';
Variable_name	Value
rpl_semi_sync_slave_enabled	OFF
connection master;
set global rpl_semi_sync_master_enabled = 0;
include/rpl_end.inc
