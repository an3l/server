include/master-slave.inc
[connection master]
connect  slave2,127.0.0.1,root,,test,$SLAVE_MYPORT2,;
connection slave2;
RESET SLAVE;
CHANGE MASTER TO master_host='127.0.0.1',master_port=MASTER_PORT,master_user='root';
START SLAVE IO_THREAD;
include/wait_for_slave_io_to_start.inc
connection master;
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id
3	slave2	SLAVE_PORT	1
2	localhost	SLAVE_PORT	1
connection slave2;
include/stop_slave_io.inc
connection master;
SHOW SLAVE HOSTS;
Server_id	Host	Port	Master_id
2	localhost	SLAVE_PORT	1
#
# MDEV-21322: report slave progress to the master
#
reset master;
set @@global.rpl_semi_sync_master_wait_point= "NONE";
# Master didn't enabled semisync
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id
2	localhost	SLAVE_PORT	1
# Master enabled semisync and Replica 1 should already be connected with server id 2
set global rpl_semi_sync_master_enabled = 1;
show variables like 'rpl_semi_sync_master_enabled';
Variable_name	Value
rpl_semi_sync_master_enabled	ON
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Semisync	File	Position	Gtid
2	localhost	SLAVE_PORT	1	OFF		0	
# Set semisync on replica 1 and check show replica hosts
connection slave;
stop slave;
reset slave;
set global rpl_semi_sync_slave_enabled = 1;
start slave;
show variables like 'rpl_semi_sync_slave_enabled';
Variable_name	Value
rpl_semi_sync_slave_enabled	ON
include/wait_for_slave_io_to_start.inc
connection master;
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Semisync	File	Position	Gtid
2	localhost	SLAVE_PORT	1	OFF		0	
# Check GTID on server id 2
create table t(t int);
insert into t values (1);
show status like 'Rpl_semi_sync_master_status';
Variable_name	Value
Rpl_semi_sync_master_status	ON
show status like 'Rpl_semi_sync_master_no_tx';
Variable_name	Value
Rpl_semi_sync_master_no_tx	0
show status like 'Rpl_semi_sync_master_yes_tx';
Variable_name	Value
Rpl_semi_sync_master_yes_tx	0
show status like 'Rpl_semi_sync_master_clients';
Variable_name	Value
Rpl_semi_sync_master_clients	1
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Semisync	File	Position	Gtid
2	localhost	SLAVE_PORT	1	OFF	master-bin.000001	674	0-1-2
# Check with new replication server with id 3
connection slave2;
RESET SLAVE;
CHANGE MASTER TO master_host='127.0.0.1',master_port=MASTER_PORT,master_user='root';
START SLAVE IO_THREAD;
include/wait_for_slave_io_to_start.inc
connection master;
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Semisync	File	Position	Gtid
3	slave2	SLAVE_PORT2	1	OFF		0	
2	localhost	SLAVE_PORT	1	OFF	master-bin.000001	674	0-1-2
# Enable semisync replication on server with id 3
connection slave2;
stop slave;
reset slave;
set global rpl_semi_sync_slave_enabled = 1;
start slave;
show variables like 'rpl_semi_sync_slave_enabled';
Variable_name	Value
rpl_semi_sync_slave_enabled	ON
include/wait_for_slave_io_to_start.inc
connection master;
show status like 'Rpl_semi_sync_master_clients';
Variable_name	Value
Rpl_semi_sync_master_clients	2
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Semisync	File	Position	Gtid
3	slave2	SLAVE_PORT2	1	OFF		0	
2	localhost	SLAVE_PORT	1	OFF	master-bin.000001	674	0-1-2
create table t1(a int);
INSERT INTO t1 SET a=1;
show status like 'Rpl_semi_sync_master_status';
Variable_name	Value
Rpl_semi_sync_master_status	ON
show status like 'Rpl_semi_sync_master_no_tx';
Variable_name	Value
Rpl_semi_sync_master_no_tx	0
show status like 'Rpl_semi_sync_master_yes_tx';
Variable_name	Value
Rpl_semi_sync_master_yes_tx	0
show status like 'Rpl_semi_sync_master_clients';
Variable_name	Value
Rpl_semi_sync_master_clients	2
show status like 'Rpl_semi_sync_master_clients';
Variable_name	Value
Rpl_semi_sync_master_clients	2
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Semisync	File	Position	Gtid
3	slave2	SLAVE_PORT2	1	OFF	master-bin.000001	1018	0-1-4
2	localhost	SLAVE_PORT	1	OFF	master-bin.000001	1018	0-1-4
# Replica 1 changed rpl_semi_sync_enabled value to 0 (asynchronous replication)
connection slave2;
stop slave;
reset slave;
set global rpl_semi_sync_slave_enabled = 0;
start slave;
[ slave status should be OFF ]
show status like 'Rpl_semi_sync_slave_status';
Variable_name	Value
Rpl_semi_sync_slave_status	OFF
connection master;
show status like 'Rpl_semi_sync_master_clients';
Variable_name	Value
Rpl_semi_sync_master_clients	1
[ master status should be ON ]
show status like 'Rpl_semi_sync_master_status';
Variable_name	Value
Rpl_semi_sync_master_status	ON
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Semisync	File	Position	Gtid
3	slave2	SLAVE_PORT2	1	OFF		0	
3	slave2	SLAVE_PORT2	1	OFF	master-bin.000001	1018	0-1-4
2	localhost	SLAVE_PORT	1	OFF	master-bin.000001	1018	0-1-4
# Stop replica 1 and see the changes 
connection slave2;
stop slave;
connection master;
show status like 'Rpl_semi_sync_master_clients';
Variable_name	Value
Rpl_semi_sync_master_clients	1
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Semisync	File	Position	Gtid
3	slave2	SLAVE_PORT2	1	OFF		0	
3	slave2	SLAVE_PORT2	1	OFF	master-bin.000001	1018	0-1-4
2	localhost	SLAVE_PORT	1	OFF	master-bin.000001	1018	0-1-4
#  Replica 2 changed rpl_semi_sync_enabled value to 0
connection slave;
stop slave;
reset slave;
set global rpl_semi_sync_slave_enabled = 0;
start slave;
connection master;
show status like 'Rpl_semi_sync_master_clients';
Variable_name	Value
Rpl_semi_sync_master_clients	0
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Semisync	File	Position	Gtid
2	localhost	SLAVE_PORT	1	OFF		0	
3	slave2	SLAVE_PORT2	1	OFF		0	
3	slave2	SLAVE_PORT2	1	OFF	master-bin.000001	1018	0-1-4
2	localhost	SLAVE_PORT	1	OFF	master-bin.000001	1018	0-1-4
# Stop replica 2 and see the changes
connection slave;
stop slave;
connection master;
show status like 'Rpl_semi_sync_master_clients';
Variable_name	Value
Rpl_semi_sync_master_clients	0
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Semisync	File	Position	Gtid
2	localhost	SLAVE_PORT	1	OFF		0	
3	slave2	SLAVE_PORT2	1	OFF		0	
3	slave2	SLAVE_PORT2	1	OFF	master-bin.000001	1018	0-1-4
2	localhost	SLAVE_PORT	1	OFF	master-bin.000001	1018	0-1-4
# Cleanup
connection slave2;
start slave;
connection slave;
start slave;
connection master;
DROP TABLE t;
connection slave;
connection master;
DROP TABLE t1;
connection slave;
# Disconnect slave from asynchronous replication
connection slave2;
include/stop_slave.inc
set global rpl_semi_sync_slave_enabled= 0;
change master to master_user='root',master_password='';
connection master;
disconnect slave2;
SHOW REPLICA HOSTS;
Server_id	Host	Port	Master_id	Semisync	File	Position	Gtid
2	localhost	SLAVE_PORT	1	OFF		0	
3	slave2	SLAVE_PORT2	1	OFF		0	
3	slave2	SLAVE_PORT2	1	OFF	master-bin.000001	1018	0-1-4
2	localhost	SLAVE_PORT	1	OFF	master-bin.000001	1018	0-1-4
connection master;
set global rpl_semi_sync_master_enabled = 0;
set global rpl_semi_sync_master_timeout= default;
SET @@global.rpl_semi_sync_master_wait_point = AFTER_COMMIT;
SELECT @@global.rpl_semi_sync_master_wait_point;
@@global.rpl_semi_sync_master_wait_point
AFTER_COMMIT
include/rpl_end.inc
