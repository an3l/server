[connection server_2]
CHANGE MASTER TO master_log_file='';
[connection server_1]
CHANGE MASTER TO master_log_file='';
.==== BEGIN include/rpl_change_topology.inc [new topology=none] ====
. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
---- Check input ----
$rpl_server_count='2'
$rpl_server_count_length='1'
new $rpl_topology=''
old $rpl_master_list=' 1'
old $rpl_sync_chain=' 12'
---- Generate $rpl_server_count_length and $rpl_master_list ----
new $rpl_server_count_length = '1'
new $rpl_master_list = '  '
---- Execute CHANGE MASTER on all servers ----
$_rpl_server='2' $_rpl_master=''
$_rpl_server='1' $_rpl_master='0'
[connection server_1]
.==== END include/rpl_change_topology.inc ====
. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
connection default;
disconnect server_2;
disconnect server_1;
==== END include/rpl_end.inc ====
 con='default' warn='1' qlog='1' rlog='1' aborterr='1'
