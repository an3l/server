....... con='server_2' warn='1' qlog='1' rlog='1' aborterr='1'
Waiting until 'Slave_IO_Running' = 'Yes' [$slave_error_param='Last_IO_Errno']
[connection server_2]
.......==== END include/wait_for_slave_param.inc [Slave_IO_Running] ====
....... con='server_2' warn='1' qlog='1' rlog='1' aborterr='1'
[connection server_2]
......==== END include/wait_for_slave_io_to_start.inc ====
...... con='server_2' warn='1' qlog='1' rlog='1' aborterr='1'
......==== BEGIN include/wait_for_slave_sql_to_start.inc ====
...... con='server_2' warn='1' qlog='1' rlog='1' aborterr='1'
.......==== BEGIN include/wait_for_slave_param.inc [Slave_SQL_Running] ====
....... con='server_2' warn='1' qlog='1' rlog='1' aborterr='1'
Waiting until 'Slave_SQL_Running' = 'Yes' [$slave_error_param='1']
[connection server_2]
.......==== END include/wait_for_slave_param.inc [Slave_SQL_Running] ====
....... con='server_2' warn='1' qlog='1' rlog='1' aborterr='1'
[connection server_2]
......==== END include/wait_for_slave_sql_to_start.inc ====
...... con='server_2' warn='1' qlog='1' rlog='1' aborterr='1'
[connection server_2]
.....==== END include/wait_for_slave_to_start.inc ====
..... con='server_2' warn='1' qlog='1' rlog='1' aborterr='1'
[connection server_2]
....==== END include/start_slave.inc ====
.... con='server_2' warn='1' qlog='1' rlog='1' aborterr='1'
[connection server_1]
...==== END include/rpl_for_each_file.inc [include/start_slave.inc] ====
... con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
[connection server_1]
..==== END include/rpl_start_slaves.inc ====
.. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
[connection server_1]
.==== END include/rpl_init.inc ====
. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
.==== BEGIN include/rpl_connect.inc [creating master] ====
. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
connect (master,127.0.0.1,root,,test,16000,)
[connection server_1]
.==== END include/rpl_connect.inc ====
. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
.==== BEGIN include/rpl_connect.inc [creating master1] ====
. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
connect (master1,127.0.0.1,root,,test,16000,)
[connection server_1]
.==== END include/rpl_connect.inc ====
. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
.==== BEGIN include/rpl_connect.inc [creating slave] ====
. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
connect (slave,127.0.0.1,root,,test,16001,)
[connection server_1]
.==== END include/rpl_connect.inc ====
. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
.==== BEGIN include/rpl_connect.inc [creating slave1] ====
. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
connect (slave1,127.0.0.1,root,,test,16001,)
[connection server_1]
.==== END include/rpl_connect.inc ====
. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
[connection default]
==== END include/master-slave.inc ====
 con='default' warn='1' qlog='1' rlog='1' aborterr='1'
[connection master]
SELECT 1;
1
1
include/rpl_end.inc
