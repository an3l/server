Generated $rpl_sync_chain = ' 12'
[connection server_1]
..==== END include/rpl_generate_sync_chain.inc ====
.. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
$rpl_sync_chain = ' 12' $rpl_only_running_threads= 
[sync server_1 -> server_2]
syncing master_file='master-bin.000001' master_pos='329'
[connection server_1]
.==== END include/rpl_sync.inc ====
. con='server_1' warn='1' qlog='1' rlog='1' aborterr='1'
