CREATE TABLE t (
path VARCHAR(100) NOT NULL COLLATE 'utf8_general_ci',
json_c1 JSON NOT NULL DEFAULT '' COLLATE 'utf8mb4_bin',
json_c2 JSON NOT NULL DEFAULT '' COLLATE 'utf8mb4_bin',
json_c3 JSON NOT NULL DEFAULT '' COLLATE 'utf8mb4_bin' CHECK(JSON_VALID(json_c3)) /* there is no need to write implicitly check constraint, currently all field constraints will be printed twice in show create statement */,
json_c4 longtext ,
json_c5 longtext CHECK(JSON_VALID(json_c5)) /* for longtext we need to write explicitly constraint */,
comment VARCHAR(100) NULL DEFAULT NULL COLLATE 'utf8_general_ci',
UNIQUE INDEX path (path),
CONSTRAINT json_test CHECK (path > 0)
);
show create table t;
Table	Create Table
t	CREATE TABLE `t` (
  `path` varchar(100) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL,
  `json_c1` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL DEFAULT '' CHECK (json_valid(`json_c1`)),
  `json_c2` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL DEFAULT '' CHECK (json_valid(`json_c2`)),
  `json_c3` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL DEFAULT '' CHECK (json_valid(`json_c3`)),
  `json_c4` longtext DEFAULT NULL,
  `json_c5` longtext DEFAULT NULL CHECK (json_valid(`json_c5`)),
  `comment` varchar(100) CHARACTER SET utf8 COLLATE utf8_general_ci DEFAULT NULL,
  UNIQUE KEY `path` (`path`),
  CONSTRAINT `json_c1` CHECK (json_valid(`json_c1`)),
  CONSTRAINT `json_c2` CHECK (json_valid(`json_c2`)),
  CONSTRAINT `CONSTRAINT_1` CHECK (json_valid(`json_c3`)),
  CONSTRAINT `CONSTRAINT_1` CHECK (json_valid(`json_c3`)),
  CONSTRAINT `CONSTRAINT_2` CHECK (json_valid(`json_c5`)),
  CONSTRAINT `json_test` CHECK (`path` > 0)
) ENGINE=MyISAM DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci
