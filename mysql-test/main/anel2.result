CREATE TABLE t2 (
a DECIMAL UNIQUE CHECK (a>3));
show create table t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `a` decimal(10,0) DEFAULT NULL,
  UNIQUE KEY `a` (`a`),
  CONSTRAINT `CONSTRAINT_1` CHECK (`a` > 3)
) ENGINE=MyISAM DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci
ALTER TABLE t2 ADD (
b INT UNIQUE CHECK (b>0));
show create table t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `a` decimal(10,0) DEFAULT NULL,
  `b` int(11) DEFAULT NULL,
  UNIQUE KEY `a` (`a`),
  UNIQUE KEY `b` (`b`),
  CONSTRAINT `CONSTRAINT_1` CHECK (`a` > 3),
  CONSTRAINT `CONSTRAINT_2` CHECK (`b` > 0)
) ENGINE=MyISAM DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci
drop table t2;
